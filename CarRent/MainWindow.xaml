<Window x:Class="CarRent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarRent"
        mc:Ignorable="d"
        Icon="/Sourse/Icon.ico"
        Title="Аренда" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowState="Maximized"
        MinWidth="1300"
        MinHeight="750"
        SizeToContent="Manual" ContentRendered="MainFrame_ContentRendered">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Background="#707070">
            <!-- Логотип -->
            <Border Width="70" Height="70" CornerRadius="35" 
        ClipToBounds="True" 
        Background="#707070"
        HorizontalAlignment="Left" VerticalAlignment="Center" 
        Margin="15,0">
                <Image Source="/Sourse/Icon.png" Stretch="UniformToFill"/>
            </Border>

            <TextBlock Text="CarRent" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="105,0,0,0" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>

            <TextBlock x:Name="textBlockname" 
                       Text="{Binding ElementName=FrameMain,Path=Content.Title}" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="22" FontWeight="Bold" 
                       Foreground="White"/>
            <!--Кнопка -->
            <Button Content="← Назад" HorizontalAlignment="Right" 
                    VerticalAlignment="Center"
                    Name="BtnBack" Click="BtnBack_Click" 
                    Height="40" Width="90" Margin="0,0,20,0"/>
        </Grid>

        <!-- Контент -->
        <Frame x:Name="FrameMain" NavigationUIVisibility="Hidden" Grid.Row="1"/>

        <!-- Подвали -->
        <Grid Grid.Row="2" Background="#707070">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="📍 г. Москва, ул. Автомобильная, 42" 
                           Foreground="White" FontSize="12" Margin="0,0,30,0"/>
                <TextBlock Text="📞 +7 (800) 555-35-35" 
                           Foreground="White" FontSize="12" Margin="0,0,30,0"/>
                <TextBlock Text="✉ info@carrent.ru" 
                           Foreground="White" FontSize="12"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>