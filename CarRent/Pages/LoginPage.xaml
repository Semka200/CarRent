<Page x:Class="CarRent.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarRent.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      >

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock HorizontalAlignment="Center" Text="Авторизация" VerticalAlignment="Top" FontSize="24" FontWeight="Bold"/>
        <TextBlock Text="Введите логин:"/>
            <TextBox x:Name="LoginBox"   Height="35" Margin="0,5,0,15"/>
        <TextBlock Text="Введите пароль:"/>
            <PasswordBox x:Name="PasswordBox" Height="35" Margin="0,5,0,20"/>
            <Button x:Name="LoginButton" Content="Войти" Height="40" Margin="0,0,0,10" Click="LoginButton_Click"/>
            <Button x:Name="GuestButton" Content="Войти как Гость" Height="40" Click="GuestButton_Click"/>
            <TextBlock x:Name="ErrorText" Text="Неверный логин или пароль!" Foreground="Red" HorizontalAlignment="Center" FontSize="16" Margin="0,15,0,0" Visibility="Collapsed"/>

        </StackPanel>
    </Grid>
</Page>
