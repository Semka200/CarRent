<Page x:Class="CarRent.Pages.ContactDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarRent.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Оформление бронирования">

    <Grid Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="500"/>
        </Grid.ColumnDefinitions>


        <!-- Email -->
        <TextBlock Grid.Row="0" Grid.Column="0" 
                   Text="Email:" 
                   VerticalAlignment="Center" 
                   Margin="10,0,10,15"
                   FontSize="14" FontWeight="Bold"/>
        <TextBox x:Name="EmailBox" 
                 Grid.Row="0" Grid.Column="1" 
                 Margin="0,0,0,15"
                 Height="35"
                 FontSize="14"/>

        <!-- Телефон -->
        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="Телефон:" 
                   VerticalAlignment="Center" 
                   Margin="10,0,10,15"
                   FontSize="14" FontWeight="Bold"/>
        <TextBox x:Name="PhoneBox" 
                 Grid.Row="1" Grid.Column="1" 
                 Margin="0,0,0,15"
                 Height="35"
                 FontSize="14"/>

        <!-- Примечание -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" 
                Padding="15" 
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Информация" 
                           FontSize="14"
                           Margin="0,0,0,5"
                           FontWeight="Bold"/>
                <TextBlock Text="Менеджер свяжется с вами в ближайшее время для подтверждения бронирования и уточнения деталей заказа."
                           TextWrapping="Wrap"
                           FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,10,0,0">
            <Button Content="На главную" 
                    Click="GoToMainPage_Click"
                    Width="100"
                    Margin="10,0,0,0"/>
        </StackPanel>

    </Grid>
</Page>