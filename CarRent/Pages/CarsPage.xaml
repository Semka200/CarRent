<Page x:Class="CarRent.Pages.CarsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarRent.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Список автомобилей"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <!-- фильтры -->
            <RowDefinition Height="*"/>
            <!-- карточки -->
        </Grid.RowDefinitions>

        <!-- Фильтры -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" 
                VerticalAlignment="Center" Margin="10">
            
            <TextBox x:Name="SearchBox" Width="200" 
                 Height="35" TextChanged="SearchBox_TextChanged"/>
            
            <TextBlock Text="Цена от:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <TextBox x:Name="MinPriceBox" Width="80" Height="35" 
             TextChanged="FilterChanged"/>

            <TextBlock Text="до:" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <TextBox x:Name="MaxPriceBox" Width="80" Height="35" 
             TextChanged="FilterChanged"/>

            <TextBlock Text="Кузов:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <ComboBox x:Name="BodyTypeBox" Width="120" Height="35" 
              SelectionChanged="FilterChanged"/>

            <CheckBox x:Name="OnlyAvailable" Content="Только доступные" 
              VerticalAlignment="Center" Margin="15,0,0,0"
              Checked="FilterChanged" Unchecked="FilterChanged"/>

            <Button x:Name="AddCarButton" Content="+ Добавить" 
              Margin="15,0,0,0" Width="120" Height="35"
              Click="AddCarButton_Click"/>

        </StackPanel>

        <!-- Карточки машин -->
        <ScrollViewer Grid.Row="1">
            <WrapPanel x:Name="CarsPanel" Margin="10" HorizontalAlignment="Center"/>
        </ScrollViewer>

    </Grid>
</Page>
