<Page x:Class="CarRent.Pages.CarDetailWindowPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarRent.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Карточка автомобиля">

    <Grid Background="#F5F5F5">

        <TextBlock HorizontalAlignment="Right"  x:Name="UsernameLabel">
            <Run Text="{Binding LastName}"/></TextBlock>

        <Border Background="White" CornerRadius="12" Padding="20"
        HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                <Border Background="White" CornerRadius="12" Padding="10">
                    <Image x:Name="CarImage" Width="550" Height="400" Stretch=" UniformToFill"/>
                </Border>

                <StackPanel>
                    <DockPanel>
                        <!-- Вывод разделителя  -->
                        <TextBlock  DockPanel.Dock="Left"  Width="20" Text=" | "></TextBlock>

                        <StackPanel Orientation="Vertical" Width="550" TextElement.FontSize="18">
                            <!-- Вывод Модели  -->
                            <TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left"  Width="400" Margin="0,5">
<Run Text="Марка: "/> <Run Text="{Binding Brand}"/></TextBlock>
                            <!-- Вывод Модели  -->
                            <TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left"  Width="400" Margin="0,5">
<Run Text="Модель: "/> <Run Text="{Binding Model}"/></TextBlock>
                            <!-- Вывод Год  -->
                            <TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left"  Width="400" Margin="0,5">
 <Run Text="Год выпуска: "/> <Run Text="{Binding Year}"/></TextBlock>
                            <!-- Вывод кузов  -->
                            <TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left"  Width="400" Margin="0,5">                                    
<Run Text="Тип кузова: "/> <Run Text="{Binding BodyType}"/></TextBlock>
                            <!-- Вывод Цвет  -->
                            <TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left"  Width="400" Margin="0,5">            
<Run Text="Цвет: "/> <Run Text="{Binding Color}" /></TextBlock>
                            <!-- Вывод Цена  -->
                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Left"  Width="400" Margin="0,5">
                          <Run Text="Цена за день: "/>
                          <Run Text="{Binding Price, StringFormat={}{0:f2} (р)}"/></TextBlock>
                            <!-- Вывод Описание   -->
                            <TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left"  Width="400" Margin="0,5" TextWrapping="Wrap">
<Run Text="Описание: "/> <Run Text="{Binding Description}"/></TextBlock>
                            <!--Вывод Доступность-->
                            <TextBlock HorizontalAlignment="Left" Width="400" Margin="0,5">
<Run Text="Статус: " FontWeight="Bold"/>
<Run x:Name="StatusText"/>
                            </TextBlock>

                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Редактировать" Name="Edid" Visibility="{Binding Control}" Grid.Column="0" Margin="0,0,5,0" Height="45" Click="Edid_Click"/>
                                <Button Content="Удалить" Name="Del" Visibility="{Binding Control}" Grid.Column="1" Margin="5,0" Height="45" Click="Del_Click" Cursor="Hand"/>
                                <Button Content="Забронировать" Name="Rent" Grid.Column="2" Margin="5,0,0,0" Height="45" Click="Rent_Click"/>
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>