<Page x:Class="CarRent.Pages.CarDetailWindowPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarRent.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Карточка автомобиля">

    <Grid>

        <TextBlock HorizontalAlignment="Right"  x:Name="UsernameLabel">
            <Run Text="{Binding LastName}"/></TextBlock>
        <StackPanel  Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Rectangle RadiusX="20" RadiusY="20" Width="300" Height="200">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{Binding Image}"></ImageBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel>
                <DockPanel>
                    <!-- Вывод разделителя  -->
                    <TextBlock  DockPanel.Dock="Left"  Width="20" Text=" | "></TextBlock>

                    <StackPanel Orientation="Vertical" Width="450">
                        <!-- Вывод Модели  -->
                        <TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left"  Width="400">
<Run Text="Марка: "/> <Run Text="{Binding Brand}"/></TextBlock>
                        <!-- Вывод Модели  -->
                        <TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left"  Width="400">
<Run Text="Модель: "/> <Run Text="{Binding Model}"/></TextBlock>
                        <!-- Вывод Год  -->
                        <TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left"  Width="400">
 <Run Text="Год выпуска: "/> <Run Text="{Binding Year}"/></TextBlock>
                        <!-- Вывод кузов  -->
                        <TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left"  Width="400">                                    
<Run Text="Тип кузова: "/> <Run Text="{Binding BodyType}"/></TextBlock>
                        <!-- Вывод Цвет  -->
                        <TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left"  Width="400">            
<Run Text="Цвет: "/> <Run Text="{Binding Color}" /></TextBlock>
                        <!-- Вывод Цена  -->
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Left"  Width="400">
                          <Run Text="Цена за день: "/>
                          <Run Text="{Binding Price, StringFormat={}{0:f2} (р)}"/></TextBlock>
                        <!-- Вывод Описание   -->
                        <TextBlock DockPanel.Dock="Left" HorizontalAlignment="Left"  Width="400">
<Run Text="Описание: "/> <Run Text="{Binding Description}"/></TextBlock>
                        <!--Вывод Доступность-->
                        <TextBlock   DockPanel.Dock="Left" HorizontalAlignment="Left"  Width="400">
<Run Text="Доступно: "/> <Run Text="{Binding Available}"/></TextBlock>


                        <StackPanel Orientation="Horizontal">
                            <Button Content="Редактировать"  Name="Edid" Visibility="{Binding Control}" Margin="5" Width="110" ></Button>
                            <Button Content="Удалить" Name="Del" Visibility="{Binding Control}" Margin="5" Width="60" ></Button>

                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </StackPanel>
        <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="Забронировать" Name="Rent" Visibility="{Binding Control}" Margin="0,0,100,50" Width="150"></Button>
    </Grid>
</Page>
